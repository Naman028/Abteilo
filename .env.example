# Local development. Copy to .env and fill in. Never commit .env.
ABTEILO_ENVIRONMENT=development
ABTEILO_COOKIE_SECURE=false

# Runtime role (no table ownership, no BYPASSRLS) and schema-owner role for migrations.
ABTEILO_DATABASE_URL=postgresql+psycopg://abteilo_app:CHANGE_ME@127.0.0.1:5432/abteilo
ABTEILO_MIGRATION_DATABASE_URL=postgresql+psycopg://abteilo_owner:CHANGE_ME@127.0.0.1:5432/abteilo

# Test database (separate from development data).
ABTEILO_TEST_DATABASE_URL=postgresql+psycopg://abteilo_app:CHANGE_ME@127.0.0.1:5432/abteilo_test
ABTEILO_TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://abteilo_owner:CHANGE_ME@127.0.0.1:5432/abteilo_test

# Password for every demo account created by `python -m abteilo.seed` (min. 12 characters).
ABTEILO_DEMO_PASSWORD=

# Free local models (default). Install Ollama and pull: qwen2.5:7b, qwen2.5-coder:7b, llama3.2
ABTEILO_OLLAMA_URL=http://127.0.0.1:11434
# Embedding model for semantic search (ollama pull bge-m3). Empty = keyword search only.
ABTEILO_EMBEDDING_MODEL=bge-m3

# Optional hosted providers; only used after the owner enables external AI in the console.
# Any OpenAI-compatible endpoint (for example a free tier of a hosted open-model API):
ABTEILO_OPENAI_COMPATIBLE_URL=
ABTEILO_OPENAI_COMPATIBLE_API_KEY=
# Claude for heavy tasks:
ABTEILO_ANTHROPIC_API_KEY=

# Serve the built frontend from FastAPI (absolute path to frontend/dist).
ABTEILO_FRONTEND_DIST=
