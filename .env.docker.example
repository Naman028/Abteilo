# Docker Compose. Copy to .env next to docker-compose.yml. Never commit it.
ABTEILO_OWNER_PASSWORD=change-me-long-random
ABTEILO_APP_PASSWORD=change-me-another-long-random
# Set to false only when testing over plain http on localhost; keep true behind HTTPS.
ABTEILO_COOKIE_SECURE=true
ABTEILO_OLLAMA_URL=http://host.docker.internal:11434
ABTEILO_OPENAI_COMPATIBLE_URL=
ABTEILO_OPENAI_COMPATIBLE_API_KEY=
ABTEILO_ANTHROPIC_API_KEY=
# Host port for the web app (default 8000).
ABTEILO_HTTP_PORT=8000
# Local embedding model for semantic search (pull it in Ollama first). Empty = keyword search only.
ABTEILO_EMBEDDING_MODEL=bge-m3
